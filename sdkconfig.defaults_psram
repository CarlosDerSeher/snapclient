# Additional settings for psram enabled boards
#
# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=n
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# With PSRAM the audio buffers live in PSRAM, so keep the Wi-Fi RX path in IRAM
# for speed. Heap and ringbuffer functions stay in flash (sdkconfig.defaults):
# with the extra Wi-Fi/lwIP IRAM options above, ESP32 boards with large codec
# drivers (e.g. LyraT 4.2, LyraT Mini) would otherwise overflow IRAM.
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

#
# Ethernet
#
CONFIG_ETH_DMA_BUFFER_SIZE=1024
CONFIG_ETH_DMA_RX_BUFFER_NUM=30

CONFIG_LWIP_MAX_ACTIVE_TCP=16
CONFIG_LWIP_MAX_LISTENING_TCP=16
