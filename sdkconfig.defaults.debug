# Debug build overrides
# Append last in SDKCONFIG_DEFAULTS so these override base settings
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y

# Use -Og optimisation for meaningful backtraces
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
# CONFIG_COMPILER_OPTIMIZATION_PERF is not set

# Halt on panic so the full backtrace is visible before any reboot
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
# CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT is not set

# Enable debug-level logging
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
# CONFIG_LOG_DEFAULT_LEVEL_NONE is not set
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Configure static wifi settings - usefult for testing

# CONFIG_ENABLE_WIFI_PROVISIONING is not set
CONFIG_WIFI_SSID="your-wifi-ssid"
CONFIG_WIFI_PASSWORD="your-wifi-password"
CONFIG_WIFI_AUTH_WPA_PSK=y
CONFIG_WIFI_MAXIMUM_RETRY=0